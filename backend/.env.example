# Documenso
DOCUMENSO_API_KEY=
DOCUMENSO_BASE_URL=https://app.documenso.com/api/v2
DOCUMENSO_WEBHOOK_SECRET=

# Database — Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/dbname?sslmode=require

# Supabase Storage — use the service_role key (never the anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=contracts

# App
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-in-production

# Outgoing email (tenant emails come from our own mailbox)
# Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (password = Google app password)
# Microsoft 365:    SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Living High
EMAIL_REPLY_TO=

# Staff login
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# seed.py super admin (account owner) — password only here, never in code
SEED_ADMIN_EMAIL=contracts@livinghigh.com.au
SEED_ADMIN_NAME=Living High Admin
SEED_ADMIN_PASSWORD=
